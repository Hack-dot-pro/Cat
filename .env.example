# =========================================================
# CAT AI - Environment Configuration (Cloudflare Pages / Local)
# =========================================================

# AI Provider Preset: xkiro | openai | openrouter | groq | deepseek | ollama | custom
VITE_AI_PROVIDER=xkiro

# OpenAI-compatible Base URL
VITE_AI_BASE_URL=https://api.xkiro.com/v1

# AI Model Name
VITE_AI_MODEL=Gwen 3.8 max

# API Key / Auth Token (Set in Cloudflare Pages Dashboard or in your local .env)
VITE_AI_API_KEY=your_xkiro_api_key_here

# Model Hyperparameters
VITE_AI_TEMPERATURE=0.7
VITE_AI_MAX_TOKENS=2048
VITE_AI_STREAMING=true
