# ==========================================
# CAT AI - HOLOGRAPHIC NEURAL OPERATING SYSTEM
# File mẫu cấu hình biến môi trường (.env.example)
# ==========================================

# 1. Cấu hình AI Provider (xkiro | openai | openrouter | deepseek | groq | ollama | custom)
VITE_AI_PROVIDER=xkiro

# 2. Địa chỉ Base URL của API Gateway (Xkiro AI)
VITE_AI_BASE_URL=https://api.xkiro.com/v1

# 3. Khóa API bí mật (nhập API Key của Xkiro hoặc Provider tương ứng)
VITE_AI_API_KEY=your_api_key_here

# 4. Tên mô hình trí tuệ nhân tạo (Mặc định: Gwen 3.8 max)
VITE_AI_MODEL=Gwen 3.8 max

# 5. Thông tin Quản trị viên hệ thống
VITE_APP_TITLE=CAT AI
VITE_USER_FULL_NAME=Vinh
VITE_USER_NAME=Vinh_Admin

# 6. Tham số suy luận và ngữ cảnh (Context Window & Speed)
VITE_CONTEXT_WINDOW=8192
VITE_INFERENCE_SPEED=1.0
VITE_TEMPERATURE=0.7
VITE_TOP_P=0.95
